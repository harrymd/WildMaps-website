{
  "version": 8,
  "name": "WDPA Protected Areas",
  "sources": {
    "wdpa": {
      "type": "vector",
      "tiles": [
        "https://habitat-web-map.s3.eu-west-2.amazonaws.com/code_output/vector_tiles/protected_areas/WDPA/wdpa_06/{z}/{x}/{y}.pbf"
      ],
      "minzoom": 0,
      "maxzoom": 6 
    }
  },
  "layers": [
    {
      "id": "wdpa-fill",
      "type": "fill",
      "source": "wdpa",
      "source-layer": "wdpa",
      "paint": {
        "fill-color": "rgba(255, 0, 0, 0.1)",
        "fill-outline-color": "#ff0000"
      }
    },
    {
      "id": "wdpa-outline",
      "type": "line",
      "source": "wdpa",
      "source-layer": "wdpa",
      "paint": {
        "line-color": "#ff0000",
        "line-width": 2
      }
    },
    {
      "id": "wdpa-labels",
      "type": "symbol",
      "source": "wdpa",
      "source-layer": "wdpa",
      "layout": {
        "text-field": ["get", "NAME"],
        "text-size": 12,
		"text-font": ["Noto Sans Regular"],
        "text-anchor": "center",
        "text-allow-overlap": false,
        "text-ignore-placement": false
      },
      "paint": {
        "text-color": "#ff0000",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    }
  ]
}
