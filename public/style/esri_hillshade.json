{
  "version": 8,
  "name": "Pre-rendered Hillshade Style",
  "sources": {
    "esri-hillshade": {
      "type": "raster",
      "tiles": [
        "https://server.arcgisonline.com/ArcGIS/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}?_={timestamp}"
      ],
      "tileSize": 256,
      "maxzoom": 13,
      "attribution": "Esri, USGS, NOAA",
	  "volatile": true
    }
  },
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "hillshade-raster",
      "type": "raster",
      "source": "esri-hillshade",
      "paint": {
        "raster-opacity": 0.6,
		"raster-fade-duration": 0
      }
    }
  ]
}
