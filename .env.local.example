# Copy this file to .env.local (gitignored) and uncomment the desired mode.
#
# Serve your local data directory with CORS headers:
#   npx serve --cors -l 8080 /path/to/your/local/data
#
# The local server must mirror the S3 bucket's directory structure, e.g.:
#   data_inputs/dictionaries/species_dictionary.csv
#   data_inputs/styles/positron_english_underlay.json
#   data_outputs/adm_bdry_info.json
#   data_outputs/raster_analysis/results_summary.json
#   data_outputs/raster_analysis/results_<datasetKey>.json
#   data_outputs/raster_tiles/SDM/<folder>/<key>_zoom_auto/{z}/{x}/{y}.png

# ── Mode 1: everything from local server ──────────────────────────────────────
#VITE_BUCKET_URL=http://localhost:8080

# ── Mode 2: local server except tiles (tiles still served from S3) ────────────
#VITE_BUCKET_URL=http://localhost:8080
#VITE_TILE_BUCKET_URL=https://wildcru-wildmaps.s3.eu-west-2.amazonaws.com

# ── Mode 3: everything from S3 (default — no variables needed) ────────────────
# (leave both lines commented out)
